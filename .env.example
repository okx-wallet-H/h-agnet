EXPO_PUBLIC_H_AGENT_API_URL=http://localhost:3000
# H Wallet API namespace is /api/h/v1. The frontend API client appends it.

# Server-side only. Do not expose these in the mobile frontend.
# H_WALLET_ADMIN_TOKEN=replace-with-local-admin-token
#
# H_AGENT_ONCHAINOS_AUTH_MODE=cli
# ONCHAINOS_CLI_PATH=/absolute/path/to/onchainos
#
# OKX / OnchainOS Open API for backend-only Swap integration.
# OKX_PROJECT_ID=replace-with-server-only-project-id
# OKX_API_KEY=replace-with-server-only-key
# OKX_SECRET_KEY=replace-with-server-only-secret
# OKX_PASSPHRASE=replace-with-server-only-passphrase
# OKX_ONCHAINOS_BASE_URL=https://web3.okx.com
# OKX_BUILDER_CODE=replace-with-x-layer-builder-code
#
# Never put OKX API keys or OnchainOS credentials in EXPO_PUBLIC_* variables.
# Future OKX / OnchainOS provider secrets must stay in backend-only env files
# or server-side secret storage.
